# Server Port
PORT=3000

# Redis Configuration (Upstash / Redis Cloud)
REDIS_URL=

# Supabase Credentials (0$ Free Tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Keys & Model Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash # or gemini-2.0-flash, gemini-2.5-flash

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile # or mixtral-8x7b-32768

PRIMARY_AI_PROVIDER=groq # 'groq' or 'gemini'
